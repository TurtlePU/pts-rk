FunctionalEquality.transportable =
fun (k : nat) (A : DirectRFirstOrder.FirstOrder.formula k) =>
forall (n : nat) (Γ : Context.Ctx nat n)
  (env env' : Syntax.Fin k -> Syntax.Term nat n),
(forall i : Syntax.Fin k,
 DirectRKernel.Core.Typed Γ (env i)
   (DirectRCodes.Codes.lift_closed DirectRCodes.Codes.Domain)) ->
(forall i : Syntax.Fin k,
 DirectRKernel.Core.Typed Γ (env' i)
   (DirectRCodes.Codes.lift_closed DirectRCodes.Codes.Domain)) ->
(forall i : Syntax.Fin k,
 DirectRLogic.NegativeLogic.inhabited Γ (DirectRCodes.Codes.GoodAt (env i))) ->
(forall i : Syntax.Fin k,
 DirectRLogic.NegativeLogic.inhabited Γ (DirectRCodes.Codes.GoodAt (env' i))) ->
(forall i : Syntax.Fin k,
 DirectRLogic.NegativeLogic.inhabited Γ
   (DirectRCodes.Codes.EqAt (env i) (env' i))) ->
DirectRLogic.NegativeLogic.inhabited Γ
  (DirectRFirstOrder.FirstOrder.translate_formula A env) ->
DirectRLogic.NegativeLogic.inhabited Γ
  (DirectRFirstOrder.FirstOrder.translate_formula A env')
     : forall {k : nat}, DirectRFirstOrder.FirstOrder.formula k -> Prop

