Inductive
derives
    : forall n : nat,
      list (DirectRFirstOrder.FirstOrder.formula n) ->
      DirectRFirstOrder.FirstOrder.formula n -> Prop :=
    hypothesis : forall (n : nat)
                   (Γ : list (DirectRFirstOrder.FirstOrder.formula n))
                   (A : DirectRFirstOrder.FirstOrder.formula n),
                 List.In A Γ -> FunctionalSyntax.derives Γ A
  | theory : forall (n : nat)
               (Γ : list (DirectRFirstOrder.FirstOrder.formula n))
               (A : DirectRFirstOrder.FirstOrder.formula n),
             FunctionalSyntax.axiom A -> FunctionalSyntax.derives Γ A
  | implication_intro : forall (n : nat)
                          (Γ : list (DirectRFirstOrder.FirstOrder.formula n))
                          (A B : DirectRFirstOrder.FirstOrder.formula n),
                        FunctionalSyntax.derives (A :: Γ) B ->
                        FunctionalSyntax.derives Γ
                          (DirectRFirstOrder.FirstOrder.implication A B)
  | implication_elim : forall (n : nat)
                         (Γ : list (DirectRFirstOrder.FirstOrder.formula n))
                         (A B : DirectRFirstOrder.FirstOrder.formula n),
                       FunctionalSyntax.derives Γ
                         (DirectRFirstOrder.FirstOrder.implication A B) ->
                       FunctionalSyntax.derives Γ A ->
                       FunctionalSyntax.derives Γ B
  | conjunction_intro : forall (n : nat)
                          (Γ : list (DirectRFirstOrder.FirstOrder.formula n))
                          (A B : DirectRFirstOrder.FirstOrder.formula n),
                        FunctionalSyntax.derives Γ A ->
                        FunctionalSyntax.derives Γ B ->
                        FunctionalSyntax.derives Γ
                          (DirectRFirstOrder.FirstOrder.conjunction A B)
  | conjunction_left : forall (n : nat)
                         (Γ : list (DirectRFirstOrder.FirstOrder.formula n))
                         (A B : DirectRFirstOrder.FirstOrder.formula n),
                       FunctionalSyntax.derives Γ
                         (DirectRFirstOrder.FirstOrder.conjunction A B) ->
                       FunctionalSyntax.derives Γ A
  | conjunction_right : forall (n : nat)
                          (Γ : list (DirectRFirstOrder.FirstOrder.formula n))
                          (A B : DirectRFirstOrder.FirstOrder.formula n),
                        FunctionalSyntax.derives Γ
                          (DirectRFirstOrder.FirstOrder.conjunction A B) ->
                        FunctionalSyntax.derives Γ B
  | disjunction_left : forall (n : nat)
                         (Γ : list (DirectRFirstOrder.FirstOrder.formula n))
                         (A B : DirectRFirstOrder.FirstOrder.formula n),
                       FunctionalSyntax.derives Γ A ->
                       FunctionalSyntax.derives Γ
                         (DirectRFirstOrder.FirstOrder.disjunction A B)
  | disjunction_right : forall (n : nat)
                          (Γ : list (DirectRFirstOrder.FirstOrder.formula n))
                          (A B : DirectRFirstOrder.FirstOrder.formula n),
                        FunctionalSyntax.derives Γ B ->
                        FunctionalSyntax.derives Γ
                          (DirectRFirstOrder.FirstOrder.disjunction A B)
  | disjunction_elim : forall (n : nat)
                         (Γ : list (DirectRFirstOrder.FirstOrder.formula n))
                         (A B C : DirectRFirstOrder.FirstOrder.formula n),
                       FunctionalSyntax.derives Γ
                         (DirectRFirstOrder.FirstOrder.disjunction A B) ->
                       FunctionalSyntax.derives (A :: Γ) C ->
                       FunctionalSyntax.derives (B :: Γ) C ->
                       FunctionalSyntax.derives Γ C
  | universal_intro : forall (n : nat)
                        (Γ : list (DirectRFirstOrder.FirstOrder.formula n))
                        (A : DirectRFirstOrder.FirstOrder.formula (S n)),
                      FunctionalSyntax.derives
                        (ListDef.map (FunctionalSyntax.frename Syntax.fsucc)
                           Γ)
                        A ->
                      FunctionalSyntax.derives Γ
                        (DirectRFirstOrder.FirstOrder.universal A)
  | universal_elim : forall (n : nat)
                       (Γ : list (DirectRFirstOrder.FirstOrder.formula n))
                       (A : DirectRFirstOrder.FirstOrder.formula (S n))
                       (t : DirectRFirstOrder.FirstOrder.term n),
                     FunctionalSyntax.derives Γ
                       (DirectRFirstOrder.FirstOrder.universal A) ->
                     FunctionalSyntax.derives Γ
                       (FunctionalSyntax.instantiate A t)
  | existential_intro : forall (n : nat)
                          (Γ : list (DirectRFirstOrder.FirstOrder.formula n))
                          (A : DirectRFirstOrder.FirstOrder.formula (S n))
                          (t : DirectRFirstOrder.FirstOrder.term n),
                        FunctionalSyntax.derives Γ
                          (FunctionalSyntax.instantiate A t) ->
                        FunctionalSyntax.derives Γ
                          (DirectRFirstOrder.FirstOrder.existential A)
  | existential_elim : forall (n : nat)
                         (Γ : list (DirectRFirstOrder.FirstOrder.formula n))
                         (A : DirectRFirstOrder.FirstOrder.formula (S n))
                         (B : DirectRFirstOrder.FirstOrder.formula n),
                       FunctionalSyntax.derives Γ
                         (DirectRFirstOrder.FirstOrder.existential A) ->
                       FunctionalSyntax.derives
                         (A
                          :: ListDef.map
                               (FunctionalSyntax.frename Syntax.fsucc) Γ)
                         (FunctionalSyntax.frename Syntax.fsucc B) ->
                       FunctionalSyntax.derives Γ B
  | classical : forall (n : nat)
                  (Γ : list (DirectRFirstOrder.FirstOrder.formula n))
                  (A : DirectRFirstOrder.FirstOrder.formula n),
                FunctionalSyntax.derives Γ
                  (FunctionalSyntax.neg (FunctionalSyntax.neg A)) ->
                FunctionalSyntax.derives Γ A
  | equality_refl : forall (n : nat)
                      (Γ : list (DirectRFirstOrder.FirstOrder.formula n))
                      (t : DirectRFirstOrder.FirstOrder.term n),
                    FunctionalSyntax.derives Γ
                      (DirectRFirstOrder.FirstOrder.equal t t)
  | equality_replace : forall (n : nat)
                         (Γ : list (DirectRFirstOrder.FirstOrder.formula n))
                         (A : DirectRFirstOrder.FirstOrder.formula (S n))
                         (t u : DirectRFirstOrder.FirstOrder.term n),
                       FunctionalSyntax.derives Γ
                         (DirectRFirstOrder.FirstOrder.equal t u) ->
                       FunctionalSyntax.derives Γ
                         (FunctionalSyntax.instantiate A t) ->
                       FunctionalSyntax.derives Γ
                         (FunctionalSyntax.instantiate A u).

