normalizeCosted_correct
     : forall (k : nat) (t : RankEstimate.Syn ?n),
       fst (normalizeCosted k t) = normalizeWithin k t
where
?n : [ |- nat]
normalizeCosted_elementary
     : forall (k : nat) (t : RankEstimate.Syn ?n),
       snd (normalizeCosted k t) <= tower (S (2 * k)) (nodes t + 5 * k + 2)
where
?n : [ |- nat]
estimatedAttempt_tower_cost
     : forall t : RankEstimate.Syn 0,
       snd (estimatedAttempt t) <=
       tower (4 * encodingSize t + 3) (11 * encodingSize t + 7)
zero_bound_normal
     : forall (G : Context.Ctx nat ?n) (t T : Syntax.Term nat ?n),
       Preservation.wf G ->
       Typing.typ G t T -> RedexBound G t 0 -> normalb t = true
where
?n : [ |- nat]
exposed_lambda_rank
     : forall (t : Syntax.Term nat ?n) (G : Context.Ctx nat ?n) (r : nat),
       Preservation.wf G ->
       TypeRank G t r ->
       isLambda t = false ->
       isLambda (greedy t) = true ->
       exists s : nat, RedexRank G t s /\ r <= s
where
?n : [ |- nat]
greedy_contracted_head_bound
     : forall (G : Context.Ctx nat ?n) (f u T : Syntax.Term nat ?n)
         (d r : nat),
       Preservation.wf G ->
       Typing.typ G (Syntax.app f u) T ->
       RedexBound G (Syntax.app f u) d ->
       isLambda (greedy f) = true -> TypeRank G (greedy f) r -> r <= d
where
?n : [ |- nat]
redex_bound_substitution
     : forall (G : Context.Ctx nat ?n) (u U : Syntax.Term nat ?n)
         (t T : Syntax.Term nat (S ?n)) (d a : nat),
       Preservation.wf G ->
       Preservation.wf (Context.cons G U) ->
       Typing.typ G u U ->
       Typing.typ (Context.cons G U) t T ->
       TypeRank G u a ->
       RedexBound G u d ->
       RedexBound (Context.cons G U) t d ->
       RedexBound G (Syntax.subst t u) (PeanoNat.Nat.max d a)
where
?n : [ |- nat]
greedy_strict_descent
     : forall (G : Context.Ctx nat ?n) (t T : Syntax.Term nat ?n) (d : nat),
       Preservation.wf G ->
       Typing.typ G t T -> RedexBound G t (S d) -> RedexBound G (greedy t) d
where
?n : [ |- nat]
bounded_rounds_normal
     : forall (d : nat) (G : Context.Ctx nat ?n) (t T : Syntax.Term nat ?n),
       Preservation.wf G ->
       Typing.typ G t T -> RedexBound G t d -> normalb (rounds d t) = true
where
?n : [ |- nat]
fixed_rank_normalization
     : forall (d : nat) (G : Context.Ctx nat ?n) (t T : Syntax.Term nat ?n),
       Preservation.wf G ->
       Typing.typ G t T ->
       RedexBound G t d ->
       exists u : RankEstimate.Syn ?n,
         fst (normalizeCosted d t) = Some u /\
         Reduction.reduces_to nat ?n t u /\
         (forall v : Syntax.Term nat ?n, ~ Reduction.step nat ?n u v) /\
         Typing.typ G u T /\
         snd (normalizeCosted d t) <= tower (2 * d + 1) (nodes t + 5 * d + 2)
where
?n : [ |- nat]
EstimatorChecks.witness_typed
     : Typing.typ Context.ε EstimatorChecks.witness (Syntax.𝓤 3)
EstimatorChecks.estimator_does_not_bound_head_ranks
     : RankEstimate.estimateRank EstimatorChecks.witness = 0 /\
       ~
       RedexBound Context.ε EstimatorChecks.witness
         (S (RankEstimate.estimateRank EstimatorChecks.witness))
conservative_rank_sound
     : forall t T : Syntax.Term nat 0,
       Typing.typ Context.ε t T ->
       RedexBound Context.ε t (conservativeRank t)
normalization_in_TOWER
     : forall t T : Syntax.Term nat 0,
       Typing.typ Context.ε t T ->
       exists u : Syntax.Term nat 0,
         fst (automaticNormalizer t) = Some u /\
         Reduction.reduces_to nat 0 t u /\
         (forall v : Syntax.Term nat 0, ~ Reduction.step nat 0 u v) /\
         Typing.typ Context.ε u T /\
         snd (automaticNormalizer t) <=
         tower (4 * encodingSize t + 3) (18 * encodingSize t + 8)
rank_bound_in_linear_time
     : forall t T : Syntax.Term nat 0,
       Typing.typ Context.ε t T ->
       RedexBound Context.ε t (fst (conservativeRankCosted t)) /\
       fst (conservativeRankCosted t) <= 2 * encodingSize t + 1 /\
       snd (conservativeRankCosted t) <= 7 * encodingSize t
