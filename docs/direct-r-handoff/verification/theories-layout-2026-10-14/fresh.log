UnaryArithmetic.axiom_translation =
fun a : UnaryArithmetic.relational_axiom =>
match a with
| UnaryArithmetic.ax_add m n => UnaryArithmetic.R1 m n
| UnaryArithmetic.ax_mul m n => UnaryArithmetic.R2 m n
| UnaryArithmetic.ax_neq m n _ =>
    CommonCodes.Neg (Unary.E (Unary.numeral m) (Unary.numeral n))
| UnaryArithmetic.ax_bound n => UnaryBounded.R4 n
