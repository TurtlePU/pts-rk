FiniteSpecialization.contextual_data_observation =
fun (q : nat) (Hq : 0 < q) =>
let e :
  exists
    (ps : list (Syntax.Term nat 0)) (τ : Syntax.Fin 31 -> Syntax.Term nat 0),
    length ps = 23 /\
    TelescopeArguments.arguments Context.ε FiniteDomainPrefix.law_telescope
      (FiniteData.data_substitution q) ps τ /\
    (forall (k : nat) (Γ : Context.Ctx nat k) (f : Syntax.Term nat k)
       (B : Syntax.Term nat 31),
     DirectRKernel.Core.Typed Γ f
       (DirectRCodes.Codes.lift_closed
          (FiniteSpecialization.observation_type B)) ->
     DirectRKernel.Core.Typed Γ
       (DirectRStructural.Structural.table_apply
          (DirectRStructural.Structural.table_apply f
             (ListDef.map DirectRCodes.Codes.lift_closed
                (FiniteData.data_arguments q)))
          (ListDef.map DirectRCodes.Codes.lift_closed ps))
       (DirectRCodes.Codes.lift_closed (Syntax.replace τ B))) :=
  FiniteSpecialization.contextual_observation q Hq in
match e with
| ex_intro _ x x0 =>
    (fun (ps : list (Syntax.Term nat 0))
       (H : exists τ : Syntax.Fin 31 -> Syntax.Term nat 0,
              length ps = 23 /\
              TelescopeArguments.arguments Context.ε
                FiniteDomainPrefix.law_telescope
                (FiniteData.data_substitution q) ps τ /\
              (forall (k : nat) (Γ : Context.Ctx nat k)
                 (f : Syntax.Term nat k) (B : Syntax.Term nat 31),
               DirectRKernel.Core.Typed Γ f
                 (DirectRCodes.Codes.lift_closed
                    (FiniteSpecialization.observation_type B)) ->
               DirectRKernel.Core.Typed Γ
                 (DirectRStructural.Structural.table_apply
                    (DirectRStructural.Structural.table_apply f
                       (ListDef.map DirectRCodes.Codes.lift_closed
                          (FiniteData.data_arguments q)))
                    (ListDef.map DirectRCodes.Codes.lift_closed ps))
                 (DirectRCodes.Codes.lift_closed (Syntax.replace τ B)))) =>
     match H with
     | ex_intro _ x1 x2 =>
         (fun (τ : Syntax.Fin 31 -> Syntax.Term nat 0)
            (H0 : length ps = 23 /\
                  TelescopeArguments.arguments Context.ε
                    FiniteDomainPrefix.law_telescope
                    (FiniteData.data_substitution q) ps τ /\
                  (forall (k : nat) (Γ : Context.Ctx nat k)
                     (f : Syntax.Term nat k) (B : Syntax.Term nat 31),
                   DirectRKernel.Core.Typed Γ f
                     (DirectRCodes.Codes.lift_closed
                        (FiniteSpecialization.observation_type B)) ->
                   DirectRKernel.Core.Typed Γ
                     (DirectRStructural.Structural.table_apply
                        (DirectRStructural.Structural.table_apply f
                           (ListDef.map DirectRCodes.Codes.lift_closed
                              (FiniteData.data_arguments q)))
                        (ListDef.map DirectRCodes.Codes.lift_closed ps))
                     (DirectRCodes.Codes.lift_closed (Syntax.replace τ B)))) =>
          match H0 with
          | conj x3 x4 =>
              (fun (Hlen : length ps = 23)
                 (H1 : TelescopeArguments.arguments Context.ε
                         FiniteDomainPrefix.law_telescope
                         (FiniteData.data_substitution q) ps τ /\
                       (forall (k : nat) (Γ : Context.Ctx nat k)
                          (f : Syntax.Term nat k) 
                          (B : Syntax.Term nat 31),
                        DirectRKernel.Core.Typed Γ f
                          (DirectRCodes.Codes.lift_closed
                             (FiniteSpecialization.observation_type B)) ->
                        DirectRKernel.Core.Typed Γ
                          (DirectRStructural.Structural.table_apply
                             (DirectRStructural.Structural.table_apply f
                                (ListDef.map DirectRCodes.Codes.lift_closed
                                   (FiniteData.data_arguments q)))
                             (ListDef.map DirectRCodes.Codes.lift_closed ps))
                          (DirectRCodes.Codes.lift_closed
                             (Syntax.replace τ B)))) =>
               match H1 with
               | conj x5 x6 =>
                   (fun
                      (Hargs : TelescopeArguments.arguments Context.ε
                                 FiniteDomainPrefix.law_telescope
                                 (FiniteData.data_substitution q) ps τ)
                      (Happ : forall (k : nat) (Γ : Context.Ctx nat k)
                                (f : Syntax.Term nat k)
                                (B : Syntax.Term nat 31),
                              DirectRKernel.Core.Typed Γ f
                                (DirectRCodes.Codes.lift_closed
                                   (FiniteSpecialization.observation_type B)) ->
                              DirectRKernel.Core.Typed Γ
                                (DirectRStructural.Structural.table_apply
                                   (DirectRStructural.Structural.table_apply
                                      f
                                      (ListDef.map
                                         DirectRCodes.Codes.lift_closed
                                         (FiniteData.data_arguments q)))
                                   (ListDef.map
                                      DirectRCodes.Codes.lift_closed ps))
                                (DirectRCodes.Codes.lift_closed
                                   (Syntax.replace τ B))) =>
                    ex_intro
                      (fun ps0 : list DirectRCodes.Codes.closed_term =>
                       length ps0 = 23 /\
                       (forall (k : nat) (Γ : Context.Ctx nat k)
                          (f : Syntax.Term nat k) 
                          (B : Syntax.Term nat 8),
                        DirectRKernel.Core.Typed Γ f
                          (DirectRCodes.Codes.lift_closed
                             (FiniteSpecialization.data_observation_type B)) ->
                        DirectRKernel.Core.Typed Γ
                          (DirectRStructural.Structural.table_apply
                             (DirectRStructural.Structural.table_apply f
                                (ListDef.map DirectRCodes.Codes.lift_closed
                                   (FiniteData.data_arguments q)))
                             (ListDef.map DirectRCodes.Codes.lift_closed ps0))
                          (DirectRCodes.Codes.lift_closed
                             (Syntax.replace (FiniteData.data_substitution q)
                                B))))
                      ps
                      (conj Hlen
                         (fun (k : nat) (Γ : Context.Ctx nat k)
                            (f : Syntax.Term nat k) 
                            (B : Syntax.Term nat 8)
                            (Hf : DirectRKernel.Core.Typed Γ f
                                    (DirectRCodes.Codes.lift_closed
                                       (FiniteSpecialization.data_observation_type
                                          B))) =>
                          let H2 :
                            DirectRKernel.Core.Typed Γ
                              (DirectRStructural.Structural.table_apply
                                 (DirectRStructural.Structural.table_apply f
                                    (ListDef.map
                                       DirectRCodes.Codes.lift_closed
                                       (FiniteData.data_arguments q)))
                                 (ListDef.map DirectRCodes.Codes.lift_closed
                                    ps))
                              (DirectRCodes.Codes.lift_closed
                                 (Syntax.replace τ
                                    (Syntax.rename
                                       (TelescopeArguments.telescope_inclusion
                                          FiniteDomainPrefix.law_telescope)
                                       B))) :=
                            Happ k Γ f
                              (Syntax.rename
                                 (TelescopeArguments.telescope_inclusion
                                    FiniteDomainPrefix.law_telescope)
                                 B)
                              Hf
                            in
                          let H3 :
                            DirectRKernel.Core.Typed Γ
                              (DirectRStructural.Structural.table_apply
                                 (DirectRStructural.Structural.table_apply f
                                    (ListDef.map
                                       DirectRCodes.Codes.lift_closed
                                       (FiniteData.data_arguments q)))
                                 (ListDef.map DirectRCodes.Codes.lift_closed
                                    ps))
                              (DirectRCodes.Codes.lift_closed
                                 (Syntax.replace
                                    (FiniteData.data_substitution q) B)) :=
                            eq_ind
                              (Syntax.replace τ
                                 (Syntax.rename
                                    (TelescopeArguments.telescope_inclusion
                                       FiniteDomainPrefix.law_telescope)
                                    B))
                              (fun t : Syntax.Term nat 0 =>
                               DirectRKernel.Core.Typed Γ
                                 (DirectRStructural.Structural.table_apply
                                    (DirectRStructural.Structural.table_apply
                                       f
                                       (ListDef.map
                                          DirectRCodes.Codes.lift_closed
                                          (FiniteData.data_arguments q)))
                                    (ListDef.map
                                       DirectRCodes.Codes.lift_closed ps))
                                 (DirectRCodes.Codes.lift_closed t))
                              H2
                              (Syntax.replace
                                 (FiniteData.data_substitution q) B)
                              (TelescopeArguments.arguments_replace_prefix
                                 Context.ε FiniteDomainPrefix.law_telescope
                                 (FiniteData.data_substitution q) ps τ Hargs
                                 B)
                            in
                          H3)))
                     x5 x6
               end) x3 x4
          end) x1 x2
     end) x x0
end
     : forall q : nat,
       0 < q ->
       exists ps : list DirectRCodes.Codes.closed_term,
         length ps = 23 /\
         (forall (k : nat) (Γ : Context.Ctx nat k) 
            (f : Syntax.Term nat k) (B : Syntax.Term nat 8),
