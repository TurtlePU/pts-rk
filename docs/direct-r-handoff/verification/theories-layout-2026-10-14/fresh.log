RelationalGround.addition_true
     : forall t u v : Relational.term 0,
       RelationalTranslation.value t + RelationalTranslation.value u =
       RelationalTranslation.value v ->
       Core.Realizes
         (RelationalTranslation.sentence (Relational.add_graph t u v))
RelationalGround.addition_false
     : forall t u v : Relational.term 0,
       RelationalTranslation.value t + RelationalTranslation.value u <>
       RelationalTranslation.value v ->
       Core.Realizes
         (CommonCodes.Neg
            (RelationalTranslation.sentence (Relational.add_graph t u v)))
