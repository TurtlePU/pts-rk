Theorem7.theorem7
     : (forall A : DirectRFirstOrder.FirstOrder.formula 0,
        FunctionalSyntax.axiom A ->
        exists p : Syntax.Term nat 0,
          Typing.typ Context.ε p
            (DirectRFirstOrder.FirstOrder.sentence_translation A)) /\
       (forall A : DirectRFirstOrder.FirstOrder.formula 0,
        FunctionalSyntax.derives nil A ->
        exists p : Syntax.Term nat 0,
          Typing.typ Context.ε p
            (DirectRFirstOrder.FirstOrder.sentence_translation A)) /\
       (forall a : Theorem7.ground_atom,
        (Theorem7.atom_truth a ->
         exists p : Syntax.Term nat 0,
           Typing.typ Context.ε p
             (DirectRFirstOrder.FirstOrder.sentence_translation
                (Theorem7.atom_formula a))) /\
        (~ Theorem7.atom_truth a ->
         exists p : Syntax.Term nat 0,
           Typing.typ Context.ε p
             (DirectRCodes.Codes.Neg
                (DirectRFirstOrder.FirstOrder.sentence_translation
                   (Theorem7.atom_formula a))))) /\
       (exists A : DirectRFirstOrder.FirstOrder.formula 0,
          (exists p : Syntax.Term nat 0,
             Typing.typ Context.ε p
               (DirectRFirstOrder.FirstOrder.sentence_translation A)) /\
          ~ FunctionalSyntax.derives nil A)
