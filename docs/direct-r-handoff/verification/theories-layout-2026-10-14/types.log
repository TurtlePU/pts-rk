fixed_rank_normalization
     : forall (d : nat) (G : Context.Ctx nat ?n) (t T : Syntax.Term nat ?n),
       Preservation.wf G ->
       Typing.typ G t T ->
       RedexRanks.RedexBound G t d ->
       exists u : Rank.RankEstimate.Syn ?n,
         fst (Runtime.normalizeCosted d t) = Some u /\
         Reduction.reduces_to nat ?n t u /\
         (forall v : Syntax.Term nat ?n, ~ Reduction.step nat ?n u v) /\
         Typing.typ G u T /\
         snd (Runtime.normalizeCosted d t) <=
         Bounds.tower (2 * d + 1) (Bounds.nodes t + 5 * d + 2)
where
?n : [ |- nat]
