        denotes H s (S n) (G & A) (fin_match y rho) C c -> IN c (U k)) ->
       (forall (C : Term nat (S n)) (a y c v : Ens),
        G & A ⊢ t ⇐ C ->
        denotes H s n G rho A a ->
