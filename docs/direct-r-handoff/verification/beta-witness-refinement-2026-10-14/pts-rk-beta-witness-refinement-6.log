       (forall x x' : Ens,
        denotes H s n G rho u x -> denotes H s n G rho u x' -> EQ x x') ->
       (forall rho' : Fin (S n) -> Ens,
        valid_valuation H s (G & A) rho' ->
        forall C C' : Term nat (S n),
        G & A ⊢ t ⇐ C ->
        G & A ⊢ t ⇐ C' ->
        C =ᵝ C' ->
        forall c c' : Ens,
        denotes H s (S n) (G & A) rho' C c ->
        denotes H s (S n) (G & A) rho' C' c' -> EQ (decode c) (decode c')) ->
