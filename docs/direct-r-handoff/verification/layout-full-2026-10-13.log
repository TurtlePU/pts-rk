Inductive
derives
    : forall n : nat,
      list (Relational.formula n) -> Relational.formula n -> Prop :=
    hypothesis : forall (n : nat) (Γ : list (Relational.formula n))
                   (A : Relational.formula n),
                 List.In A Γ -> Relational.derives Γ A
  | theory : forall (n : nat) (Γ : list (Relational.formula n))
               (A : Relational.formula n),
             Relational.axiom A -> Relational.derives Γ A
  | implication_intro : forall (n : nat) (Γ : list (Relational.formula n))
                          (A B : Relational.formula n),
                        Relational.derives (A :: Γ) B ->
                        Relational.derives Γ (Relational.implies A B)
  | implication_elim : forall (n : nat) (Γ : list (Relational.formula n))
                         (A B : Relational.formula n),
                       Relational.derives Γ (Relational.implies A B) ->
                       Relational.derives Γ A -> Relational.derives Γ B
  | universal_intro : forall (n : nat) (Γ : list (Relational.formula n))
                        (A : Relational.formula (S n)),
                      Relational.derives
                        (ListDef.map (Relational.frename fsucc) Γ) A ->
                      Relational.derives Γ (Relational.all A)
  | universal_elim : forall (n : nat) (Γ : list (Relational.formula n))
                       (A : Relational.formula (S n)) 
                       (t : Relational.term n),
                     Relational.derives Γ (Relational.all A) ->
                     Relational.derives Γ (Relational.instantiate A t)
  | classical : forall (n : nat) (Γ : list (Relational.formula n))
                  (A : Relational.formula n),
                Relational.derives Γ (Relational.neg (Relational.neg A)) ->
                Relational.derives Γ A
  | equality_refl : forall (n : nat) (Γ : list (Relational.formula n))
                      (t : Relational.term n),
                    Relational.derives Γ (Relational.equal t t)
  | equality_replace : forall (n : nat) (Γ : list (Relational.formula n))
                         (A : Relational.formula (S n))
                         (t u : Relational.term n),
                       Relational.derives Γ (Relational.equal t u) ->
                       Relational.derives Γ (Relational.instantiate A t) ->
                       Relational.derives Γ (Relational.instantiate A u).

