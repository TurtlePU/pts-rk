                         FiniteDomainPrefix.law_telescope
                         (FiniteData.data_substitution q) ps τ /\
                       (forall (k : nat) (Γ : Context.Ctx nat k)
                          (f : Syntax.Term nat k) 
                          (B : Syntax.Term nat 31),
                        DirectRKernel.Core.Typed Γ f
                          (DirectRCodes.Codes.lift_closed
                             (FiniteSpecialization.observation_type B)) ->
                        DirectRKernel.Core.Typed Γ
                          (DirectRStructural.Structural.table_apply
                             (DirectRStructural.Structural.table_apply f
                                (ListDef.map DirectRCodes.Codes.lift_closed
                                   (FiniteData.data_arguments q)))
                             (ListDef.map DirectRCodes.Codes.lift_closed ps))
                          (DirectRCodes.Codes.lift_closed
                             (Syntax.replace τ B)))) =>
               match H1 with
