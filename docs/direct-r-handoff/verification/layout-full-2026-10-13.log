             (ListDef.map DirectRCodes.Codes.lift_closed
                (FiniteData.data_arguments q)))
          (ListDef.map DirectRCodes.Codes.lift_closed ps))
       (DirectRCodes.Codes.lift_closed (Syntax.replace τ B))) :=
  FiniteSpecialization.contextual_observation q Hq in
match e with
| ex_intro _ x x0 =>
    (fun (ps : list (Syntax.Term nat 0))
       (H : exists τ : Syntax.Fin 31 -> Syntax.Term nat 0,
              length ps = 23 /\
              TelescopeArguments.arguments Context.ε
                FiniteDomainPrefix.law_telescope
                (FiniteData.data_substitution q) ps τ /\
              (forall (k : nat) (Γ : Context.Ctx nat k)
