fix denote
  (n q : nat) (e : FiniteExpressions.expression) (u v : Syntax.Term nat n)
  {struct e} : Syntax.Term nat n :=
  match e with
  | FiniteExpressions.zero =>
      DirectRCodes.Codes.lift_closed
        (DirectRFiniteTables.FiniteTables.point q 0)
  | FiniteExpressions.first => u
  | FiniteExpressions.second => v
  | FiniteExpressions.successor e0 =>
      Syntax.app
        (DirectRCodes.Codes.lift_closed
           (DirectRFiniteTables.FiniteTables.capped_successor q))
        (denote n q e0 u v)
  | FiniteExpressions.addition e0 f =>
      Syntax.app
        (Syntax.app
           (DirectRCodes.Codes.lift_closed (BinaryTables.capped_addition q))
           (denote n q e0 u v))
        (denote n q f u v)
  | FiniteExpressions.multiplication e0 f =>
      Syntax.app
        (Syntax.app
           (DirectRCodes.Codes.lift_closed
              (BinaryTables.capped_multiplication q))
           (denote n q e0 u v))
        (denote n q f u v)
  end
     : forall {n : nat},
       nat ->
       FiniteExpressions.expression ->
       Syntax.Term nat n -> Syntax.Term nat n -> Syntax.Term nat n

