denotes_root_beta
     : forall W H s : Ens,
       transitive_set W ->
       INC omega_codes W ->
       tower_envelope W H ->
       (forall P : Prop, P \/ ~ P) ->
       cardinal_comparability ->
       infinite_powerset_gap ->
       family_choice ->
       selects_global_witnesses H s ->
       forall (n : nat) (G : Ctx nat n) (rho : Fin n -> Ens) 
         (A : Term nat n) (t : Term nat (S n)) (u T : Term nat n),
       wf G ->
       G ⊢ [A] t $ u ⇐ T ->
       (forall (U : Term nat n) (l : nat) (a a' : Ens),
        G ⊢ U ⇐ 𝓤 l ->
        U =ᵝ A ->
        denotes H s n G rho U a ->
        denotes H s n G rho A a' -> EQ (decode a) (decode a')) ->
       (forall (B C : Term nat (S n)) (j k : nat) (a y b c : Ens),
        G & A ⊢ B ⇐ 𝓤 j ->
        G & A ⊢ C ⇐ 𝓤 k ->
        B =ᵝ C ->
        denotes H s n G rho A a ->
        IN y (decode a) ->
        denotes H s (S n) (G & A) (fin_match y rho) B b ->
        denotes H s (S n) (G & A) (fin_match y rho) C c ->
        EQ (decode b) (decode c)) ->
       (forall (l : nat) (a : Ens),
        G ⊢ A ⇐ 𝓤 l -> denotes H s n G rho A a -> IN a (U l)) ->
       (forall (C : Term nat (S n)) (k : nat) (a y c : Ens),
        G & A ⊢ C ⇐ 𝓤 k ->
        denotes H s n G rho A a ->
        IN y (decode a) ->
        denotes H s (S n) (G & A) (fin_match y rho) C c -> IN c (U k)) ->
       (forall (C : Term nat (S n)) (a y c v : Ens),
        G & A ⊢ t ⇐ C ->
        denotes H s n G rho A a ->
        IN y (decode a) ->
        denotes H s (S n) (G & A) (fin_match y rho) C c ->
        denotes H s (S n) (G & A) (fin_match y rho) t v -> IN v (decode c)) ->
       (forall a x : Ens,
        G ⊢ u ⇐ A ->
        denotes H s n G rho A a -> denotes H s n G rho u x -> IN x (decode a)) ->
       forall v : Ens,
       denotes H s n G rho ([A] t $ u) v -> denotes H s n G rho (t ◁ u) v
