counting_bijection
     : forall i : nat, bijection (U i) omega_codes (counting_graph i)
counting_roundtrip
     : forall (i : nat) (x : Ens),
       IN x (U i) ->
       EQ
         (apply_set (inverse (U i) omega_codes (counting_graph i))
            (apply_set (counting_graph i) x))
         x
rank_zero_decoding_bound
