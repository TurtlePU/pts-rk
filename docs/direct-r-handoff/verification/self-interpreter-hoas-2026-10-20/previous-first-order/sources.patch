+From Stdlib Require Import Arith.PeanoNat Bool.Bool Lia.
+From PTSrk Require Import Syntax Context Typing Ranks.
+From PTSrk.NormalizationComplexity Require Import Greedy.
+Import Context.
+
+Module ChurchSyntax.
+
+Definition arrow {n} (X Y : Term nat n) : Term nat n := Π X (shift Y).
+Definition unary {n} (X : Term nat n) : Term nat n := arrow X X.
+Definition binary {n} (X : Term nat n) : Term nat n := arrow X (unary X).
+
+Fixpoint fin_index {n} (i : Fin n) : nat :=
+  match i with fzero => 0 | fsucc j => S (fin_index j) end.
+
+Fixpoint nat_fold {n} (z s : Term nat n) (k : nat) : Term nat n :=
+  match k with 0 => z | S j => app s (nat_fold z s j) end.
+
+(** The original annotated syntax is one grammar for programs AND types.
+    Binders are represented as raw nodes; indices encode binding explicitly.
+    All natural sort labels are data, independent of the carrier rank r. *)
+Fixpoint ast_fold {m n} (z s u v p l a : Term nat n) (t : Term nat m) : Term nat n :=
+  match t with
+  | 𝓤 k => app u (nat_fold z s k)
+  | Π T U => app (app p (ast_fold z s u v p l a T)) (ast_fold z s u v p l a U)
+  | var i => app v (nat_fold z s (fin_index i))
+  | lam T b => app (app l (ast_fold z s u v p l a T)) (ast_fold z s u v p l a b)
+  | app f x => app (app a (ast_fold z s u v p l a f)) (ast_fold z s u v p l a x)
+  end.
+
+Definition body {m} (t : Term nat m) : Term nat 8 :=
+  ast_fold (var (fsucc (fsucc (fsucc (fsucc (fsucc (fsucc fzero)))))))
+    (var (fsucc (fsucc (fsucc (fsucc (fsucc fzero))))))
+    (var (fsucc (fsucc (fsucc (fsucc fzero)))))
+    (var (fsucc (fsucc (fsucc fzero))))
+    (var (fsucc (fsucc fzero))) (var (fsucc fzero)) (var fzero) t.
+
+Definition quote (r : nat) {m} (t : Term nat m) : Term nat 0 :=
+  lam (𝓤 r)
+  (lam (var fzero)
+  (lam (unary (var (fsucc fzero)))
+  (lam (unary (var (fsucc (fsucc fzero))))
+  (lam (unary (var (fsucc (fsucc (fsucc fzero)))))
+  (lam (binary (var (fsucc (fsucc (fsucc (fsucc fzero))))))
+  (lam (binary (var (fsucc (fsucc (fsucc (fsucc (fsucc fzero)))))))
+  (lam (binary (var (fsucc (fsucc (fsucc (fsucc (fsucc (fsucc fzero))))))))
+    (body t)))))))).
+
+Definition code_type (r : nat) : Term nat 0 :=
+  Π (𝓤 r)
+  (Π (var fzero)
+  (Π (unary (var (fsucc fzero)))
+  (Π (unary (var (fsucc (fsucc fzero))))
+  (Π (unary (var (fsucc (fsucc (fsucc fzero)))))
+  (Π (binary (var (fsucc (fsucc (fsucc (fsucc fzero))))))
+  (Π (binary (var (fsucc (fsucc (fsucc (fsucc (fsucc fzero)))))))
+  (Π (binary (var (fsucc (fsucc (fsucc (fsucc (fsucc (fsucc fzero))))))))
+    (var (fsucc (fsucc (fsucc (fsucc (fsucc (fsucc (fsucc fzero))))))))))))))).
+
+Lemma nat_fold_variables_normal n (z s : Fin n) k :
+  normalb (nat_fold (var z) (var s) k) = true.
+Proof. induction k; cbn [nat_fold normalb isLambda]; [reflexivity | rewrite IHk; reflexivity]. Qed.
+
+Lemma ast_fold_variables_normal m n (z s u v p l a : Fin n) (t : Term nat m) :
+  normalb (ast_fold (var z) (var s) (var u) (var v) (var p) (var l) (var a) t) = true.
+Proof.
+  induction t; cbn [ast_fold normalb isLambda].
+  - rewrite nat_fold_variables_normal; reflexivity.
+  - rewrite IHt1, IHt2; reflexivity.
+  - rewrite nat_fold_variables_normal; reflexivity.
+  - rewrite IHt1, IHt2; reflexivity.
+  - rewrite IHt1, IHt2; reflexivity.
+Qed.
+
+Theorem quote_normal r m (t : Term nat m) : normalb (quote r t) = true.
+Proof.
+  unfold quote.
+  cbn [normalb unary binary arrow shift rename weak fin_match isLambda].
+  unfold body. rewrite ast_fold_variables_normal; reflexivity.
+Qed.
+
+Lemma arrow_sort n (G : Ctx nat n) X Y r s :
+  @typ nat RankSorts n G X (𝓤 r) -> @typ nat RankSorts n G Y (𝓤 s) ->
+  @typ nat RankSorts n G (arrow X Y) (𝓤 (Nat.max (S r) s)).
+Proof.
+  intros HX HY. unfold arrow. eapply typ_Π with (ℓₜ := r) (ℓᵤ := s).
+  - exact HX.
+  - change (typ (G & X) (shift Y) (shift (𝓤 s))). apply weakening; exact HY.
+  - reflexivity.
+Qed.
+Lemma unary_sort n (G : Ctx nat n) X r :
+  @typ nat RankSorts n G X (𝓤 r) ->
+  @typ nat RankSorts n G (unary X) (𝓤 (S r)).
+Proof.
+  intro HX. unfold unary.
+  replace (S r) with (Nat.max (S r) r) by (rewrite Nat.max_l; lia).
+  apply arrow_sort; assumption.
+Qed.
+Lemma binary_sort n (G : Ctx nat n) X r :
+  @typ nat RankSorts n G X (𝓤 r) ->
+  @typ nat RankSorts n G (binary X) (𝓤 (S r)).
+Proof.
+  intro HX. unfold binary.
+  replace (S r) with (Nat.max (S r) (S r)) by apply Nat.max_id.
+  apply arrow_sort; [exact HX | apply unary_sort; exact HX].
+Qed.
+
+Lemma arrow_application n (G : Ctx nat n) f x X Y :
+  @typ nat RankSorts n G f (arrow X Y) -> @typ nat RankSorts n G x X ->
+  @typ nat RankSorts n G (app f x) Y.
+Proof.
+  intros Hf Hx. replace Y with (subst (shift Y) x) by syntax_simp.
+  eapply typ_app; eassumption.
+Qed.
+Lemma binary_application n (G : Ctx nat n) f x y X :
+  @typ nat RankSorts n G f (binary X) ->
+  @typ nat RankSorts n G x X -> @typ nat RankSorts n G y X ->
+  @typ nat RankSorts n G (app (app f x) y) X.
+Proof.
+  intros Hf Hx Hy. apply arrow_application with (X := X); [|exact Hy].
+  apply arrow_application with (X := X); assumption.
+Qed.
+
+Theorem nat_fold_typed n (G : Ctx nat n) z s X k :
+  @typ nat RankSorts n G z X -> @typ nat RankSorts n G s (unary X) ->
+  @typ nat RankSorts n G (nat_fold z s k) X.
+Proof.
+  intros Hz Hs. induction k; cbn [nat_fold]; [exact Hz |].
+  apply arrow_application with (X := X); assumption.
+Qed.
+
+Theorem ast_fold_typed m n (G : Ctx nat n) z s u v p l a X (t : Term nat m) :
+  @typ nat RankSorts n G z X ->
+  @typ nat RankSorts n G s (unary X) ->
+  @typ nat RankSorts n G u (unary X) ->
+  @typ nat RankSorts n G v (unary X) ->
+  @typ nat RankSorts n G p (binary X) ->
+  @typ nat RankSorts n G l (binary X) ->
+  @typ nat RankSorts n G a (binary X) ->
+  @typ nat RankSorts n G (ast_fold z s u v p l a t) X.
+Proof.
+  intros Hz Hs Hu Hv Hp Hl Ha. induction t; cbn [ast_fold].
+  - apply arrow_application with (X := X); [exact Hu | apply nat_fold_typed; assumption].
+  - apply binary_application; assumption.
+  - apply arrow_application with (X := X); [exact Hv | apply nat_fold_typed; assumption].
+  - apply binary_application; assumption.
+  - apply binary_application; assumption.
+Qed.
+
+Theorem quote_typing r m (t : Term nat m) :
+  @typ nat RankSorts 0 ε (quote r t) (code_type r).
+Proof.
+  unfold quote, code_type.
+  eapply typ_λ with (ℓ := 0); [constructor; reflexivity |].
+  eapply typ_λ with (ℓ := r); [constructor |].
+  do 3 (eapply typ_λ with (ℓ := S r); [apply unary_sort; constructor |]).
+  do 3 (eapply typ_λ with (ℓ := S r); [apply binary_sort; constructor |]).
+  unfold body. apply ast_fold_typed; constructor.
+Qed.
+
+Theorem code_type_sort r : @typ nat RankSorts 0 ε (code_type r) (𝓤 (S (S r))).
+Proof.
+  unfold code_type.
+  eapply typ_Π with (ℓₜ := 0) (ℓᵤ := S (S r)).
+  - constructor; reflexivity.
+  - eapply typ_Π with (ℓₜ := r) (ℓᵤ := S (S r)).
+    + constructor.
+    + do 3 (eapply typ_Π with (ℓₜ := S r) (ℓᵤ := S (S r));
+        [apply unary_sort; constructor | | change (S (S r) = Nat.max (S (S r)) (S (S r))); rewrite Nat.max_id; reflexivity]).
+      do 2 (eapply typ_Π with (ℓₜ := S r) (ℓᵤ := S (S r));
+        [apply binary_sort; constructor | | change (S (S r) = Nat.max (S (S r)) (S (S r))); rewrite Nat.max_id; reflexivity]).
+      eapply typ_Π with (ℓₜ := S r) (ℓᵤ := r).
+      * apply binary_sort; constructor.
+      * constructor.
+      * change (S (S r) = Nat.max (S (S r)) r). rewrite Nat.max_l; lia.
+    + change (S (S r) = Nat.max (S r) (S (S r))). rewrite Nat.max_r; lia.
+  - change (S (S r) = Nat.max 1 (S (S r))). rewrite Nat.max_r; lia.
+Qed.
+
+(** No source typing, source rank bound, normalization, or finite syntax
+    bound is a premise.  This is exact deep raw-syntax representation only;
+    it does NOT evaluate the represented term at its dependent source type. *)
+Theorem every_original_term_has_church_code r m (t : Term nat m) :
+  normalb (quote r t) = true /\
+  @typ nat RankSorts 0 ε (quote r t) (code_type r) /\
+  @typ nat RankSorts 0 ε (code_type r) (𝓤 (S (S r))).
+Proof. repeat split; [apply quote_normal | apply quote_typing | apply code_type_sort]. Qed.
+
+Print Assumptions quote_normal.
+Print Assumptions nat_fold_typed.
+Print Assumptions ast_fold_typed.
+Print Assumptions quote_typing.
+Print Assumptions code_type_sort.
+Print Assumptions every_original_term_has_church_code.
+
+End ChurchSyntax.
