+From PTSrk Require Import Syntax Context Typing Ranks Reduction AbstractRewriting.
+From PTSrk.NormalizationComplexity Require Import Morphisms.
+From PTSrk.SelfInterpreter Require Import ChurchSyntax.
+Import ChurchSyntax.ChurchSyntax.
+Import Context.
+
+(** An actual object-language application to an arbitrary carrier and algebra.
+    This is a fold of RAW syntax, not dependent typed unquotation. *)
+Module ChurchSyntaxFold.
+
+Lemma nat_fold_rename m n (rho : Fin m -> Fin n) z s k :
+  rename rho (nat_fold z s k) = nat_fold (rename rho z) (rename rho s) k.
+Proof. induction k; cbn [nat_fold rename]; congruence. Qed.
+
+Lemma ast_fold_rename m n p (rho : Fin n -> Fin p) z s u v pr l a
+  (t : Term nat m) :
+  rename rho (ast_fold z s u v pr l a t) =
+  ast_fold (rename rho z) (rename rho s) (rename rho u) (rename rho v)
+    (rename rho pr) (rename rho l) (rename rho a) t.
+Proof.
+  induction t; cbn [ast_fold rename]; rewrite ?nat_fold_rename;
+    congruence.
+Qed.
+
+Lemma nat_fold_replace m n (sigma : Fin m -> Term nat n) z s k :
+  replace sigma (nat_fold z s k) =
+  nat_fold (replace sigma z) (replace sigma s) k.
+Proof. induction k; cbn [nat_fold replace]; congruence. Qed.
+
+Lemma ast_fold_replace m n p (sigma : Fin n -> Term nat p) z s u v pr l a
+  (t : Term nat m) :
+  replace sigma (ast_fold z s u v pr l a t) =
+  ast_fold (replace sigma z) (replace sigma s) (replace sigma u)
+    (replace sigma v) (replace sigma pr) (replace sigma l) (replace sigma a) t.
+Proof.
+  induction t; cbn [ast_fold replace]; rewrite ?nat_fold_replace;
+    congruence.
+Qed.
+
+Definition run {m n} r (t : Term nat m) (X z s u v pr l a : Term nat n) :=
+  app (app (app (app (app (app (app (app
+    (rename (fun i : Fin 0 => match i with end) (quote r t)) X)
+    z) s) u) v) pr) l) a.
+
+Ltac fold_beta_cleanup :=
+  unfold subst; cbn [replace]; rewrite ast_fold_replace;
+  simpl; unfold shift; autorewrite with syntax; simpl.
+
+Theorem run_fold m n r (t : Term nat m) (X z s u v pr l a : Term nat n) :
+  reduces_to nat n (run r t X z s u v pr l a) (ast_fold z s u v pr l a t).
+Proof.
+  unfold run, quote, body; cbn [rename]. rewrite ast_fold_rename.
+  simpl.
+  eapply rtc_step; [do 7 apply step_app_left; apply step_beta |].
+  fold_beta_cleanup.
+  eapply rtc_step; [do 6 apply step_app_left; apply step_beta |].
+  fold_beta_cleanup.
+  eapply rtc_step; [do 5 apply step_app_left; apply step_beta |].
+  fold_beta_cleanup.
+  eapply rtc_step; [do 4 apply step_app_left; apply step_beta |].
+  fold_beta_cleanup.
+  eapply rtc_step; [do 3 apply step_app_left; apply step_beta |].
+  fold_beta_cleanup.
+  eapply rtc_step; [do 2 apply step_app_left; apply step_beta |].
+  fold_beta_cleanup.
+  eapply rtc_step; [apply step_app_left, step_beta |].
+  fold_beta_cleanup.
+  eapply rtc_step; [apply step_beta |].
+  fold_beta_cleanup. reflexivity.
+Qed.
+
+Definition algebra_type {n} (X : Term nat n) : Term nat n :=
+  arrow X (arrow (unary X) (arrow (unary X) (arrow (unary X)
+    (arrow (binary X) (arrow (binary X) (arrow (binary X) X)))))).
+
+Lemma instantiate_typing n (G : Ctx nat n) r q X :
+  @typ nat RankSorts n G q
+    (rename (fun i : Fin 0 => match i with end) (code_type r)) ->
+  @typ nat RankSorts n G X (𝓤 r) ->
+  @typ nat RankSorts n G (app q X) (algebra_type X).
+Proof.
+  intros Hq HX. unfold code_type in Hq; cbn [rename] in Hq.
+  pose proof (typ_app (𝓤 r) Hq HX) as H.
+  match type of H with
+  | @typ _ _ _ _ _ ?T => replace (algebra_type X) with T; [exact H |]
+  end.
+  unfold algebra_type, unary, binary, arrow; syntax_simp; syntax_simp.
+Qed.
+
+Theorem run_typing m n r (G : Ctx nat n) (t : Term nat m) X z s u v pr l a :
+  @typ nat RankSorts n G X (𝓤 r) ->
+  @typ nat RankSorts n G z X ->
+  @typ nat RankSorts n G s (unary X) ->
+  @typ nat RankSorts n G u (unary X) ->
+  @typ nat RankSorts n G v (unary X) ->
+  @typ nat RankSorts n G pr (binary X) ->
+  @typ nat RankSorts n G l (binary X) ->
+  @typ nat RankSorts n G a (binary X) ->
+  @typ nat RankSorts n G (run r t X z s u v pr l a) X.
+Proof.
+  intros HX Hz Hs Hu Hv Hp Hl Ha. unfold run.
+  eapply arrow_application with (X := binary X); [|exact Ha].
+  eapply arrow_application with (X := binary X); [|exact Hl].
+  eapply arrow_application with (X := binary X); [|exact Hp].
+  eapply arrow_application with (X := unary X); [|exact Hv].
+  eapply arrow_application with (X := unary X); [|exact Hu].
+  eapply arrow_application with (X := unary X); [|exact Hs].
+  eapply arrow_application with (X := X); [|exact Hz].
+  apply instantiate_typing with (r := r); [|exact HX].
+  apply typing_rename with (G := ε); [intros i; inversion i |apply quote_typing].
+Qed.
+
+Print Assumptions run_fold.
+Print Assumptions run_typing.
+
+End ChurchSyntaxFold.
