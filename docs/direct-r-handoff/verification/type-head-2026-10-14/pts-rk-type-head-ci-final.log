application_realization
     : forall W H s : Ens,
       transitive_set W ->
       INC omega_codes W ->
       tower_envelope W H ->
       (forall P : Prop, P \/ ~ P) ->
       cardinal_comparability ->
       infinite_powerset_gap ->
       family_choice ->
       selects_global_witnesses H s ->
       forall (n : nat) (G : Ctx nat n) (rho : Fin n -> Ens) 
         (A : Term nat n) (B : Term nat (S n)) (t u : Term nat n) 
         (a : Ens) (b : Ens -> Ens) (f x : Ens) (m k : nat),
       G ⊢ t ⇐ Π A B ->
       G ⊢ u ⇐ A ->
       denotes H s n G rho A a ->
       (forall y : Ens,
        IN y (decode a) ->
        denotes H s (S n) (G & A) (fin_match y rho) B (b y)) ->
       family_extensional (fun y : Ens => decode (b y)) ->
       denotes H s n G rho t f ->
       denotes H s n G rho u x ->
       IN a (U m) ->
       (forall y : Ens, IN y (decode a) -> IN (b y) (U k)) ->
       IN f (decode (semantic_product H s a b)) ->
       IN x (decode a) -> realizes H s G rho (t $ u) (B ◁ u)
        rocq ZFC_model/RuleRealization.{glob,vo}

