       Core.Realizes (Codes.Neg (UnaryArithmetic.MulAtom m n k))
unary_relational_axioms
     : forall a : UnaryArithmetic.relational_axiom,
       exists p : Term nat 0, ε ⊢ p ⇐ UnaryArithmetic.axiom_translation a
UnaryArithmetic.axiom_translation =
fun a : UnaryArithmetic.relational_axiom =>
match a with
| UnaryArithmetic.ax_add m n => UnaryArithmetic.R1 m n
| UnaryArithmetic.ax_mul m n => UnaryArithmetic.R2 m n
| UnaryArithmetic.ax_neq m n _ =>
    Codes.Neg (Unary.E (Unary.numeral m) (Unary.numeral n))
| UnaryArithmetic.ax_bound n => UnaryBounded.R4 n
| UnaryArithmetic.ax_compare n => UnaryAxioms.R5 n
end
     : UnaryArithmetic.relational_axiom -> Codes.closed_term

Arguments UnaryArithmetic.axiom_translation a
