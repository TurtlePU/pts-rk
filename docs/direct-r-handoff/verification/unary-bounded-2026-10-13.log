unary_bounded_cases
     : forall cutoff : nat,
       exists p : Term nat 0,
         ε ⊢ p
         ⇐ Π Unary.Domain
             (Codes.Arrow (Unary.admitted Codes.V0)
                (Unary.Case cutoff Codes.V0))
Unary.Case =
fun (n cutoff : nat) (d : Term nat n) =>
Codes.FlatOr
  (ListDef.map
     (fun i : nat => Unary.E d (Codes.lift_closed (Unary.numeral i)))
     (ListDef.seq 0 (S cutoff)) ++
   Unary.O (Codes.lift_closed (Unary.numeral (S cutoff))) d :: nil)
     : forall {n : nat}, nat -> Term nat n -> Term nat n

Arguments Unary.Case {n}%_nat_scope cutoff%_nat_scope d
Unary.Inv =
fun (n cutoff : nat) (d : Term nat n) =>
NegativeLogic.positive_invariant (Unary.G d) (Unary.Case cutoff d)
     : forall {n : nat}, nat -> Term nat n -> Term nat n

Arguments Unary.Inv {n}%_nat_scope cutoff%_nat_scope d
Unary.ground_order_realized
     : forall i j : nat,
       i <= j -> Core.Realizes (Unary.O (Unary.numeral i) (Unary.numeral j))
Unary.case_successor_realized
     : forall (Γ : Ctx nat ?n) (cutoff : nat) (d : Term nat ?n),
       Core.Typed Γ d (Codes.lift_closed Unary.Domain) ->
       NegativeLogic.inhabited Γ (Unary.G d) ->
       NegativeLogic.inhabited Γ (Unary.Case cutoff d) ->
       NegativeLogic.inhabited Γ
         (Unary.Case cutoff (app (Codes.lift_closed Unary.successor) d))
where
?n : [ |- nat]
