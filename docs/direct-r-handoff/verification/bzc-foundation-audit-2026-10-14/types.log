RankedHereditary.certified_application
     : forall W H s : Sets.Ens,
       HierarchyBounds.transitive_set W ->
       Sets.INC CountableCodes.omega_codes W ->
       SuppliedHierarchy.tower_envelope W H ->
       (forall P : Prop, P \/ ~ P) ->
       CardinalClassification.cardinal_comparability ->
       CardinalClassification.infinite_powerset_gap ->
       CountableDichotomy.family_choice ->
       GlobalOperations.selects_global_witnesses H s ->
       forall (n : nat) (G : Context.Ctx nat n)
         (rho : Syntax.Fin n -> Sets.Ens) (A : Syntax.Term nat n)
         (B : Syntax.Term nat (S n)) (t u : Syntax.Term nat n) 
         (m k : nat) (a : Sets.Ens) (b : Sets.Ens -> Sets.Ens)
         (f x : Sets.Ens),
       Preservation.wf G ->
       RankedHereditary.RS.certified_variables H s G rho ->
       Typing.typ (Context.cons G A) B (Syntax.𝓤 k) ->
       CanonicalTypeWitnesses.beta_normal B ->
       RankedHereditary.RD.certificate H s n G rho A 
         (Syntax.𝓤 m) a
         (CodeUniverses.CodeUniverses.repr
            (CodeUniverses.CodeUniverses.sort m)) ->
       (forall y : Sets.Ens,
        Sets.IN y (CardinalHierarchy.decode a) ->
        RankedHereditary.RD.certificate H s (S n) 
          (Context.cons G A) (Syntax.fin_match y rho) B 
          (Syntax.𝓤 k) (b y)
          (CodeUniverses.CodeUniverses.repr
             (CodeUniverses.CodeUniverses.sort k))) ->
       RankedHereditary.RD.certificate H s n G rho t 
         (Syntax.Π A B) f (GlobalOperations.semantic_product H s a b) ->
       RankedHereditary.RD.certificate H s n G rho u A x a ->
       SetFunctions.family_extensional
         (fun y : Sets.Ens => CardinalHierarchy.decode (b y)) ->
       RankedHereditary.normalizes H s G rho (Syntax.app t u)
         (Syntax.subst B u)
         (GlobalOperations.semantic_application H s a b f x) 
         (b x)
