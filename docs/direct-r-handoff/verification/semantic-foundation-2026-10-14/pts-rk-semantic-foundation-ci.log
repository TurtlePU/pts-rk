realized_root_beta
     : forall W H s : Ens,
       transitive_set W ->
       INC omega_codes W ->
       tower_envelope W H ->
       (forall P : Prop, P \/ ~ P) ->
       cardinal_comparability ->
       infinite_powerset_gap ->
       family_choice ->
       selects_global_witnesses H s ->
       forall (n : nat) (G : Ctx nat n) (rho : Fin n -> Ens) 
         (A : Term nat n) (B t : Term nat (S n)) (u : Term nat n) 
         (m k : nat),
       wf G ->
       G ⊢ A ⇐ 𝓤 m ->
       G & A ⊢ t ⇐ B ->
       G ⊢ u ⇐ A ->
       valid_valuation H s G rho ->
       realizes H s G rho A (𝓤 m) ->
       realizes H s G rho u A ->
       (forall rho' : Fin (S n) -> Ens,
        valid_valuation H s (G & A) rho' -> realizes H s (G & A) rho' t B) ->
       (forall rho' : Fin (S n) -> Ens,
        valid_valuation H s (G & A) rho' -> realizes H s (G & A) rho' B (𝓤 k)) ->
       (forall (C : Term nat n) (l : nat) (a a' : Ens),
        G ⊢ C ⇐ 𝓤 l ->
        C =ᵝ A ->
        denotes H s n G rho C a ->
        denotes H s n G rho A a' -> EQ (decode a) (decode a')) ->
       (forall rho' : Fin (S n) -> Ens,
        valid_valuation H s (G & A) rho' ->
        forall v v' : Ens,
        denotes H s (S n) (G & A) rho' t v ->
        denotes H s (S n) (G & A) rho' t v' -> EQ v v') ->
       (forall x x' : Ens,
        denotes H s n G rho u x -> denotes H s n G rho u x' -> EQ x x') ->
       (forall rho' : Fin (S n) -> Ens,
        valid_valuation H s (G & A) rho' ->
        forall C C' : Term nat (S n),
        G & A ⊢ t ⇐ C ->
        G & A ⊢ t ⇐ C' ->
        C =ᵝ C' ->
        forall c c' : Ens,
        denotes H s (S n) (G & A) rho' C c ->
        denotes H s (S n) (G & A) rho' C' c' -> EQ (decode c) (decode c')) ->
       forall v : Ens,
       denotes H s n G rho ([A] t $ u) v ->
       exists c : Ens,
         denotes H s n G rho (t ◁ u) v /\
         denotes H s n G rho (B ◁ u) c /\ IN v (decode c) /\ IN c (U k)
        rocq ZFC_model/RootBeta.{glob,vo}

