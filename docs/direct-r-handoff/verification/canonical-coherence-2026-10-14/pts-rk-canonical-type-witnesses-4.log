normal_lambda_witness
     : forall (G : Ctx nat ?n) (A : Term nat ?n) (t : Term nat (S ?n))
         (T : Term nat ?n),
       wf G ->
       G ⊢ [A] t ⇐ T ->
       exists B : Term nat (S ?n), beta_normal B /\ G & A ⊢ t ⇐ B
where
?n : [ |- nat]
normal_application_witness
     : forall (G : Ctx nat ?n) (t u T : Term nat ?n),
       wf G ->
       G ⊢ t $ u ⇐ T ->
       exists (A : Term nat ?n) (B : Term nat (S ?n)),
         beta_normal A /\
         beta_normal B /\ G ⊢ t ⇐ Π A B /\ G ⊢ u ⇐ A /\ T =ᵝ B ◁ u
where
?n : [ |- nat]
