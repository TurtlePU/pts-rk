normal_application_witness
     : forall (G : Ctx nat ?n) (t u T : Term nat ?n),
       wf G ->
       G ⊢ t $ u ⇐ T ->
       exists (A : Term nat ?n) (B : Term nat (S ?n)),
         beta_normal A /\
         beta_normal B /\ G ⊢ t ⇐ Π A B /\ G ⊢ u ⇐ A /\ T =ᵝ B ◁ u
