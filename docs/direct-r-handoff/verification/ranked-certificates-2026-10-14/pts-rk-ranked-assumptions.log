         T = Syntax.Π A B /\
         Reduction.step nat n (Syntax.app (Syntax.lam A t) u)
           (Syntax.subst t u) /\
         RankedRootBeta.RD.certificate H s n G rho 
           (Syntax.subst t u) (Syntax.subst B u) v b
