NeutralCutRank.bounded_exposed_lambda_domain_rank
     : forall (G : Context.Ctx nat ?n) (D : Context.Ctx nat ?m)
         (sigma : Syntax.Fin ?n -> Syntax.Term nat ?m)
         (f F : Syntax.Term nat ?n) (C : Syntax.Term nat ?m)
         (t : Syntax.Term nat (S ?m)) (r : nat),
       Preservation.wf G ->
       Preservation.wf D ->
       SyntaxSubstitution.typed_substitution G D sigma ->
       NeutralCutRank.bounded_substitution r G sigma ->
       Typing.typ G f F ->
       (exists (A : Syntax.Term nat ?n) (B : Syntax.Term nat (S ?n)),
          F = Syntax.Π A B) ->
       CanonicalTypeWitnesses.beta_normal f ->
       CanonicalRenaming.not_lambda f ->
       Reduction.reduces_to nat ?m (Syntax.replace sigma f) (Syntax.lam C t) ->
       exists (a b : nat) (B : Syntax.Term nat (S ?m)),
         a < r /\
         b <= r /\
         Typing.typ D C (Syntax.𝓤 a) /\
         Typing.typ (Context.cons D C) B (Syntax.𝓤 b) /\
         Typing.typ (Context.cons D C) t B
where
?n : [ |- nat]
?m : [ |- nat]
