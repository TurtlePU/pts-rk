NeutralCutRank.headed_type_rank
     : forall (i : Fin ?n) (t : Term nat ?n),
       NeutralCutRank.headed_by i t ->
       forall (G : Ctx nat ?n) (T : Term nat ?n) (r : nat),
       wf G ->
       G ⊢ t ⇐ T -> G ⊢ G !! i ⇐ 𝓤 r -> exists k : nat, k <= r /\ G ⊢ T ⇐ 𝓤 k
where
?n : [ |- nat]
NeutralCutRank.headed_substituted_product_rank
     : forall (i : Fin ?n) (f : Term nat ?n),
       NeutralCutRank.headed_by i f ->
       forall (G : Ctx nat ?n) (T : Term nat ?n) (r m : nat) 
         (D : Ctx nat m) (sigma : Fin ?n -> Term nat m) 
         (A : Term nat m) (B : Term nat (S m)),
       wf G ->
       wf D ->
       G ⊢ f ⇐ T ->
       G ⊢ G !! i ⇐ 𝓤 r ->
       typed_substitution G D sigma ->
       D ⊢ replace sigma f ⇐ Π A B ->
       exists a b : nat, a < r /\ b <= r /\ D ⊢ A ⇐ 𝓤 a /\ D & A ⊢ B ⇐ 𝓤 b
where
?n : [ |- nat]
NeutralCutRank.exposed_lambda_domain_rank
     : forall (G : Ctx nat ?n) (A : Term nat ?n) (f F : Term nat (S ?n))
         (u C : Term nat ?n) (t : Term nat (S ?n)) 
         (r : nat),
       wf G ->
       G ⊢ A ⇐ 𝓤 r ->
       G & A ⊢ f ⇐ F ->
       (exists (D : Term nat (S ?n)) (E : Term nat (S (S ?n))), F = Π D E) ->
       beta_normal f ->
       not_lambda f ->
       G ⊢ u ⇐ A ->
       f ◁ u ↠ᵝ [C] t ->
       exists (m k : nat) (B : Term nat (S ?n)),
         m < r /\ k <= r /\ G ⊢ C ⇐ 𝓤 m /\ G & C ⊢ B ⇐ 𝓤 k /\ G & C ⊢ t ⇐ B
where
?n : [ |- nat]
        rocq ZFC_model/NeutralCutRank.{glob,vo}
