relational_axiom_preservation
     : forall (k n : nat) (Γ : Ctx nat n) (env : Fin k -> Term nat n)
         (A : Relational.formula k),
       Relational.axiom A ->
       exists p : Term nat n, Γ ⊢ p ⇐ RelationalTranslation.formula A env
Theorem4.theorem4
     : (forall A : Relational.formula 0,
        Relational.axiom A ->
        exists p : Term nat 0, ε ⊢ p ⇐ RelationalTranslation.sentence A) /\
       (forall A : Relational.formula 0,
        Relational.derives nil A ->
        exists p : Term nat 0, ε ⊢ p ⇐ RelationalTranslation.sentence A) /\
       (forall a : Theorem4.ground_atom,
        (Theorem4.atom_truth a ->
         exists p : Term nat 0,
           ε ⊢ p ⇐ RelationalTranslation.sentence (Theorem4.atom_formula a)) /\
        (~ Theorem4.atom_truth a ->
         exists p : Term nat 0,
           ε ⊢ p
           ⇐ CommonCodes.Neg
               (RelationalTranslation.sentence (Theorem4.atom_formula a)))) /\
       (exists A : Relational.formula 0,
          (exists p : Term nat 0, ε ⊢ p ⇐ RelationalTranslation.sentence A) /\
          ~ Relational.derives nil A)
RelationalDeduction.sentence_preservation
     : forall A : Relational.formula 0,
       Relational.derives nil A ->
       exists p : Term nat 0, ε ⊢ p ⇐ RelationalTranslation.sentence A
Theorem4.nonfaithfulness
     : exists A : Relational.formula 0,
         Core.Realizes (RelationalTranslation.sentence A) /\
         ~ Relational.derives nil A
