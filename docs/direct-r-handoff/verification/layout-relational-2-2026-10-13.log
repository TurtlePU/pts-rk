RelationalTranslation.formula_typed
     : forall (A : Relational.formula ?k) (n : nat) 
         (Γ : Ctx nat n) (env : Fin ?k -> Term nat n),
       (forall i : Fin ?k,
        Core.Typed Γ (env i)
          (CommonCodes.lift_closed DirectRUnary.Unary.Domain)) ->
       Core.Typed Γ (RelationalTranslation.formula A env)
         (𝓤 (RelationalTranslation.formula_rank A))
where
?k : [ |- nat]
RelationalTranslation.term_admitted
     : forall (Γ : Ctx nat ?n) (env : Fin ?k -> Term nat ?n)
         (t : Relational.term ?k),
       (forall i : Fin ?k,
        Core.Typed Γ (env i)
          (CommonCodes.lift_closed DirectRUnary.Unary.Domain)) ->
       (forall i : Fin ?k,
        DirectRLogic.NegativeLogic.inhabited Γ
          (DirectRUnary.Unary.admitted (env i))) ->
       DirectRLogic.NegativeLogic.inhabited Γ
         (DirectRUnary.Unary.admitted (RelationalTranslation.term env t))
where
?k : [ |- nat]
?n : [ |- nat]
RelationalTranslation.instantiate_translation
     : forall (A : Relational.formula (S ?k)) (t : Relational.term ?k)
         (env : Fin ?k -> Term nat ?n),
       RelationalTranslation.formula (Relational.instantiate A t) env =
       subst (RelationalTranslation.formula A (transpose env))
         (RelationalTranslation.term env t)
where
?k : [ |- nat]
?n : [ |- nat]
RelationalTranslation.universal_elimination
     : forall (Γ : Ctx nat ?n) (env : Fin ?k -> Term nat ?n)
         (A : Relational.formula (S ?k)) (t : Relational.term ?k),
       (forall i : Fin ?k,
        Core.Typed Γ (env i)
          (CommonCodes.lift_closed DirectRUnary.Unary.Domain)) ->
       (forall i : Fin ?k,
        DirectRLogic.NegativeLogic.inhabited Γ
          (DirectRUnary.Unary.admitted (env i))) ->
       DirectRLogic.NegativeLogic.inhabited Γ
         (RelationalTranslation.formula (Relational.all A) env) ->
       DirectRLogic.NegativeLogic.inhabited Γ
         (RelationalTranslation.formula (Relational.instantiate A t) env)
where
?k : [ |- nat]
?n : [ |- nat]
RelationalGround.addition_true
     : forall t u v : Relational.term 0,
       RelationalTranslation.value t + RelationalTranslation.value u =
       RelationalTranslation.value v ->
       Core.Realizes
         (RelationalTranslation.sentence (Relational.add_graph t u v))
RelationalGround.addition_false
     : forall t u v : Relational.term 0,
       RelationalTranslation.value t + RelationalTranslation.value u <>
       RelationalTranslation.value v ->
       Core.Realizes
         (CommonCodes.Neg
            (RelationalTranslation.sentence (Relational.add_graph t u v)))
