       CanonicalApplication.CR.realizes H s G rho t (Syntax.Π A B) ->
       CanonicalApplication.CR.realizes H s G rho u A ->
       CanonicalApplication.CR.realizes H s G rho A (Syntax.𝓤 m) ->
       (forall rho' : Syntax.Fin (S n) -> Sets.Ens,
        CanonicalApplication.CR.valid_valuation H s (Context.cons G A) rho' ->
        CanonicalApplication.CR.realizes H s (Context.cons G A) rho' B
          (Syntax.𝓤 k)) ->
