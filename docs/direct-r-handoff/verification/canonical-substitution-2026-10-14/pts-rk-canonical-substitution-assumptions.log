CanonicalHereditary.rank_one_normal_lambda_application
     : forall W H s : Sets.Ens,
       HierarchyBounds.transitive_set W ->
       Sets.INC CountableCodes.omega_codes W ->
       SuppliedHierarchy.tower_envelope W H ->
       (forall P : Prop, P \/ ~ P) ->
       CardinalClassification.cardinal_comparability ->
       CardinalClassification.infinite_powerset_gap ->
       CountableDichotomy.family_choice ->
       GlobalOperations.selects_global_witnesses H s ->
       forall (n : nat) (G : Context.Ctx nat n)
         (rho : Syntax.Fin n -> Sets.Ens) (A : Syntax.Term nat n)
         (B t : Syntax.Term nat (S n)) (u : Syntax.Term nat n) 
         (v : Sets.Ens) (k : nat),
       Preservation.wf G ->
       Typing.typ G (Syntax.Π A B) (Syntax.𝓤 1) ->
       Typing.typ (Context.cons G A) B (Syntax.𝓤 k) ->
       Typing.typ (Context.cons G A) t B ->
       Typing.typ G u A ->
       CanonicalTypeWitnesses.beta_normal (Syntax.lam A t) ->
       CanonicalTypeWitnesses.beta_normal B ->
       CanonicalTypeWitnesses.beta_normal u ->
       CanonicalHereditary.CR.valid_valuation H s G rho ->
       CanonicalHereditary.CR.realizes H s G rho A (Syntax.𝓤 0) ->
       CanonicalHereditary.CR.realizes H s G rho u A ->
       (forall rho' : Syntax.Fin (S n) -> Sets.Ens,
        CanonicalHereditary.CR.valid_valuation H s (Context.cons G A) rho' ->
        CanonicalHereditary.CR.realizes H s (Context.cons G A) rho' t B) ->
       (forall rho' : Syntax.Fin (S n) -> Sets.Ens,
        CanonicalHereditary.CR.valid_valuation H s (Context.cons G A) rho' ->
        CanonicalHereditary.CR.realizes H s (Context.cons G A) rho' B
          (Syntax.𝓤 k)) ->
       CanonicalHereditary.CD.denotes H s n G rho
         (Syntax.app (Syntax.lam A t) u) v ->
       k <= 1 /\
       Reduction.step nat n (Syntax.app (Syntax.lam A t) u)
         (Syntax.subst t u) /\
       CanonicalTypeWitnesses.beta_normal (Syntax.subst t u) /\
       CanonicalTypeWitnesses.beta_normal (Syntax.subst B u) /\
       Typing.typ G (Syntax.subst t u) (Syntax.subst B u) /\
       Typing.typ G (Syntax.subst B u) (Syntax.𝓤 k) /\
       (exists c : Sets.Ens,
          CanonicalHereditary.CD.denotes H s n G rho (Syntax.subst t u) v /\
          CanonicalHereditary.CD.denotes H s n G rho (Syntax.subst B u) c /\
          Sets.IN v (CardinalHierarchy.decode c) /\
          Sets.IN c (CodeUniverses.CodeUniverses.U k))
