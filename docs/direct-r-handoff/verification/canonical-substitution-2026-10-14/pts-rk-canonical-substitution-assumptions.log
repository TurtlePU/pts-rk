CanonicalHereditary.rank_one_normal_application
     : forall (G : Context.Ctx nat ?n) (f u A : Syntax.Term nat ?n)
         (B : Syntax.Term nat (S ?n)),
       Preservation.wf G ->
       Typing.typ G f (Syntax.Π A B) ->
       Typing.typ G u A ->
       Typing.typ G (Syntax.Π A B) (Syntax.𝓤 1) ->
       CanonicalTypeWitnesses.beta_normal f ->
       CanonicalTypeWitnesses.beta_normal u ->
       CanonicalTypeWitnesses.beta_normal (Syntax.Π A B) ->
       CanonicalTypeWitnesses.beta_normal (Syntax.subst B u) /\
       (exists N : Syntax.Term nat ?n,
          Reduction.reduces_to nat ?n (Syntax.app f u) N /\
          CanonicalTypeWitnesses.beta_normal N /\
          Typing.typ G N (Syntax.subst B u))
where
?n : [ |- nat]
