bounded_separation_statement
     : forall (A : Fin ?n) (p : Bounded.Formula (S ?n)) (r : Fin ?n -> Ens),
       holds (bounded_separation A p) r <->
       (exists Y : Ens,
          forall x : Ens,
          IN x Y <-> IN x (r A) /\ Bounded.holds p (fin_match x r))
