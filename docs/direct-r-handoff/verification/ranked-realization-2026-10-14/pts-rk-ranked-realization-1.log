product_realization_from_pointwise
     : forall W H s : Ens,
       transitive_set W ->
       INC omega_codes W ->
       tower_envelope W H ->
       (forall P : Prop, P \/ ~ P) ->
       cardinal_comparability ->
       infinite_powerset_gap ->
       family_choice ->
       selects_global_witnesses H s ->
       forall (n : nat) (G : Ctx nat n) (rho : Fin n -> Ens) 
         (A : Term nat n) (B : Term nat (S n)) (a : Ens) 
         (m k : nat),
       denotes H s n G rho A a ->
       IN a (U m) ->
       (forall x : Ens,
        IN x (decode a) ->
        exists b : Ens,
          IN b (U k) /\ denotes H s (S n) (G & A) (fin_match x rho) B b) ->
       realizes H s G rho (Π A B) (𝓤 (Nat.max (S m) k))
        rocq ZFC_model/DenotationChoice.{glob,vo}
