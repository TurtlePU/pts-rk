ChurchSTLC.church_stlc_reduction
     : forall (t u : Syntax.Term nat 1) (A : ChurchSTLC.Ty),
       ChurchSTLC.has_type ChurchSTLC.emptyEnv Syntax.fzero t A ->
       ChurchSTLC.has_type ChurchSTLC.emptyEnv Syntax.fzero u A ->
       Typing.typ Context.ε (ChurchSTLC.close t)
         (Syntax.Π (Syntax.𝓤 0) (ChurchSTLC.code A Syntax.fzero)) /\
       Typing.typ Context.ε (ChurchSTLC.close u)
         (Syntax.Π (Syntax.𝓤 0) (ChurchSTLC.code A Syntax.fzero)) /\
       (ChurchSTLC.convertible t u <->
        DefEq.def_equiv nat 0 (ChurchSTLC.close t) (ChurchSTLC.close u)) /\
       encodingSize (ChurchSTLC.close t) + encodingSize (ChurchSTLC.close u) =
       encodingSize t + encodingSize u + 4
        rocq theories/NormalizationComplexity/Audit.{glob,vo}
